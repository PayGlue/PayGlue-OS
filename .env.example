# PayGlue-OS — self-host configuration.
# Copy to .env and fill in. Every value here is read by backend settings.py;
# names must match exactly.

# --- Required ---------------------------------------------------------------

# Django. The dev server falls back to an insecure key when DJANGO_DEBUG=1;
# production (DJANGO_DEBUG=0) refuses to boot without a real one.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-use-openssl-rand-base64-48
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-api-hostname.example

# Postgres + Redis. Note: there is no REDIS_URL -- Celery reads these two.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ghost_glue
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Encrypts stored provider credentials at rest (Fernet). This has to be a real
# 32-byte key, base64 encoded; a placeholder here stops the application from
# starting, and the compose file's own default is only used while this line is
# absent. Generate one with:
#
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# Keep it. Losing it means every stored provider credential has to be entered
# again.
CREDENTIAL_ENCRYPTION_KEY=

# Signing in. Two ways, and you only configure one of them.
#
# 1) Accounts kept by this installation. The default in docker-compose, and
#    nothing else to set up: the first time you open the dashboard it walks
#    you through creating the first account. Everyone after that arrives by
#    invitation. No authenticator apps, no magic links, no social sign-in.
#    Password resets go by email, so configure outbound mail below or a
#    forgotten password becomes a manage.py job.
LOCAL_AUTH_ENABLED=1
# Signs the tokens local accounts get. Empty means the Django secret key,
# which is one less thing to keep, and rotating that invalidates every token.
# LOCAL_AUTH_JWT_SECRET=
# LOCAL_AUTH_TOKEN_TTL_HOURS=12
#
# 2) A hosted identity provider (Supabase, or any compatible JWKS issuer).
#    Set LOCAL_AUTH_ENABLED=0 and fill these in. Adds authenticator apps,
#    magic links and sign-in with Google or GitHub. The frontend needs its own
#    two variables at build time, see the bottom of this file.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWKS_KEYS={"keys":[...]}  # inline JWKS, skips the fetch on cold start

# Webhook ingestion. A long random string; WEBHOOK_ALLOW_GLOBAL_ENDPOINT_TOKEN=1
# lets the single token work for all tenants, which is fine for a
# single-operator deployment. Provider HMAC signatures remain the primary layer.
WEBHOOK_ENDPOINT_TOKEN=change-me-use-openssl-rand-base64-32
WEBHOOK_ALLOW_GLOBAL_ENDPOINT_TOKEN=1

# Host ports. Only needed when something already occupies one of them, which
# is common for 5432 if you run Postgres for something else.
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# BACKEND_HOST_PORT=8000
# FRONTEND_HOST_PORT=5173

# --- Optional ---------------------------------------------------------------

# Outbound email (member notifications, one-time codes). Without a key, set
# EMAIL_BACKEND to Django's console backend for development.
# RESEND_API_KEY=
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_REDIRECT_TO= # staging installs: reroute EVERY outbound mail to one address

# Admin API access to the auth project (account deletion, user provisioning).
# SUPABASE_SERVICE_ROLE_KEY=

# --- Frontend (build-time, frontend/.env) ------------------------------------
# VITE_API_BASE_URL=
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-publishable-key
