# Supabase project the dashboard signs in against. Both required.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend origin the dashboard calls. Falls back to the origin the dashboard
# itself is served from, which is correct when one host serves both.
VITE_API_BASE_URL=

# Where this installation is reachable from outside. Both optional.
#
# VITE_PUBLIC_API_BASE_URL ends up in embed snippets and webhook URLs, so it has
# to be the address your readers' browsers and your payment provider can reach,
# which is not necessarily the one the dashboard talks to. Falls back to
# VITE_API_BASE_URL, then to the current origin.
#
# VITE_PUBLIC_APP_BASE_URL is where the dashboard lives, used for display and
# for links back into it. Falls back to the current origin.
VITE_PUBLIC_API_BASE_URL=
VITE_PUBLIC_APP_BASE_URL=

# The address this installation answers support mail at. Left empty, the
# dashboard's support shortcut and the contact hints are hidden rather than
# pointing at an inbox nobody reads.
VITE_SUPPORT_EMAIL=

# Addresses that sign in with a password instead of a magic link. Empty means
# everyone uses the magic link. Comma-separated. "*" matches any run of
# characters inside the local part, never across the @:
#   me@example.com     one address
#   me+*@example.com   plus-addressing, one mailbox, many accounts
#   *@example.com      every address on a domain
VITE_PASSWORD_SIGNIN_EMAILS=

# Cloudflare Turnstile site key for the signup form. Optional: without it the
# widget is not rendered.
VITE_TURNSTILE_SITE_KEY=

# Checkout for the hosted plans, which a self-hosted installation has no use
# for. Leave unset.
VITE_ENABLE_CHECKOUT=
VITE_CREEM_CHECKOUT_TIER1=
VITE_CREEM_CHECKOUT_TIER2=
VITE_CREEM_CHECKOUT_TIER3=
VITE_CREEM_CHECKOUT_TIER4=
VITE_CREEM_CHECKOUT_TIER5=

# There is no product analytics in this build. Nothing is sent anywhere, so
# there is no key to configure and nothing to opt out of. See
# frontend/src/lib/posthog.ts if you want to wire up your own.
